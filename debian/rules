#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@ --buildsystem=cmake --builddirectory=build/deb

override_dh_auto_configure:
	dh_auto_configure -- \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DPHI_ADAPTER_THINQ_USE_LOCAL_ADAPTER_SDK=OFF

# A template the host layer instantiates (`phi-backend-thinq@main`) when the
# backend intent is applied; nothing to enable or start here.
override_dh_installsystemd:
	dh_installsystemd --no-enable --no-start --name=phi-backend-thinq@
